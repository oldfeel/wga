# WGA server — copy to .env and edit. Never commit real secrets.

# HTTP
# Windows 上 8080 可能被 Steam 占用，可改 8088
HTTP_ADDR=0.0.0.0:8088
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (local Windows or Ubuntu, no Docker)
# Windows 本机示例（复用已有 PG16；库名 wga）:
# DATABASE_URL=postgres://saleor:saleor@127.0.0.1:5432/wga?sslmode=disable
DATABASE_URL=postgres://wga:change-me@127.0.0.1:5432/wga?sslmode=disable

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=168

# Optional hardening on 1C2G
# PG pool
DB_MAX_CONNS=10
